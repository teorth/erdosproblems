{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Erdos problems table",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["number"],
    "properties": {
      "number": { "type": "string", "pattern": "^[0-9\\-]+$" },
      "prize": { "type": "string" },
      "informal_status": {
        "$comment": "The human/mathematical status of the problem, ignoring formalization.",
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "open",
              "proved",
              "disproved",
              "solved",
              "falsifiable",
              "verifiable",
              "decidable",
              "not provable",
              "not disprovable",
              "independent"
            ]
          },
          "last_update": { "type": "string", "format": "date" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      },
      "formal_status": {
        "$comment": "Whether a *solution* to the problem has been formalized in a proof assistant.",
        "type": "object",
        "properties": {
          "state": { "enum": ["unformalized", "Lean"] },
          "last_update": { "type": "string", "format": "date" },
          "url": { "type": "string", "pattern": "^https?://" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      },
      "status": {
        "$comment": "Derived from informal_status and formal_status by scripts/derive_status.py; do not edit by hand.",
        "type": "object",
        "properties": {
          "state": { "type": "string" },
          "last_update": { "type": "string", "format": "date" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      },
      "oeis": {
        "type": "array",
        "items": { "type": "string" }
       },
      "formalized": {
        "$comment": "Whether the problem *statement* is formalized in the formal-conjectures repository; autogenerated by scripts/update_formalization_status.py.",
        "type": "object",
        "properties": {
          "state": { "enum": ["yes", "no"] },
          "last_update": { "type": "string", "format": "date" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      },
      "forum": {
        "$comment": "Discussion thread for this problem on erdosproblems.com; autogenerated by scripts/update_forum_status.py.  Absent when the problem has no thread.",
        "type": "object",
        "required": ["posts"],
        "properties": {
          "posts": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      },
      "comments": { "type": "string" },
      "tags": {
        "type": "array",
        "items": { "type": "string" },
        "uniqueItems": true
      }
    },
    "additionalProperties": false
  },
  "uniqueItems": true
}
